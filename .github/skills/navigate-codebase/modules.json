  "modules": [
    {
      "file": "dt/__init__.py",
      "description": "Package init. Holds `__version__` \u2014 bump here and in pyproject.toml together."
    },
    {
      "file": "dt/cache_index.py",
      "description": "Fast existence cache / cache index."
    },
    {
      "file": "dt/cache_ops.py",
      "description": "Cache population helpers (internal)."
    },
    {
      "file": "dt/cli.py",
      "description": "All Click CLI commands (~5900 lines). Each command delegates immediately to its module."
    },
    {
      "file": "dt/config.py",
      "description": ".dt/config.yaml read/write. Keys: secrets.backend, secrets.gcp.project, secrets.prefix, summary.output_dir, auth.owner."
    },
    {
      "file": "dt/diff.py",
      "description": "Diff system. DiffHandler ABC, plugin registry (dvc_tools.diff_handlers entry-point group), content_diff(), tree_diff(). File fetching via 'dvc get --rev' subprocess (not dvc.api)."
    },
    {
      "file": "dt/dvc_lock.py",
      "description": "Workspace lock compatible with DVC's `.dvc/tmp/lock`. Use when an operation must not race `dvc` itself."
    },
    {
      "file": "dt/dvc_utils.py",
      "description": "Thin wrappers around raw dvc subprocess calls."
    },
    {
      "file": "dt/errors.py",
      "description": "Exception hierarchy: DiffError, AuthError, SummaryError, etc."
    },
    {
      "file": "dt/hpc.py",
      "description": "HPC parallel job submission via qxub. Used by push, fetch, add, data-status, remote-verify. get_prefixes_for_worker() partitions the 256 md5 prefixes across workers; build_qxub_command()/monitor_jobs() are the general low-level helpers."
    },
    {
      "file": "dt/remote_ops.py",
      "description": "dt remote move / copy. copy_remote duplicates a remote's blob tree (reflink\u2192hardlink\u2192copy by default; independent=True forces real byte copies for cross-fs or broader-perms volumes; optional --as registers a new DVC remote). move_remote relocates: same-fs os.rename, else copy\u2192verify(reuses remote_verify.verify_remote; --quick=size+presence)\u2192delete source, then repoint_remotes() rewrites every .dvc/config remote whose URL resolved to the old path. Parallel per-prefix transfer via archive.operations._enumerate_prefix_dirs; reuses cache_ops _try_reflink/_try_hardlink/_try_copy."
    },
    {
      "file": "dt/remote_quarantine.py",
      "description": "Quarantine corrupt/incomplete blobs in a remote so `dvc push` re-uploads them."
    },
    {
      "file": "dt/remote_verify.py",
      "description": "Exhaustive md5 verification of a local DVC remote's blob tree. Catches truncated/corrupt blobs and stray *.tmp files (status 'incomplete') from interrupted transfers. Single-node (thread pool, --jobs) or distributed (qxub, --workers, prefix-partitioned). Incremental: per-prefix ledger under <remote>/.dt-verify/ skips blobs unchanged (size+mtime) since they last passed; --full re-hashes, --no-ledger disables. Emits a machine-readable JSON report (bad + incomplete lists). Reuses utils.md5_file, archive.operations layout detection, and hpc.py partitioning. Shared walker for the planned dt remote move/copy."
    },
    {
      "file": "dt/repo_graph_render.py",
      "description": "Renderers (text/dot/mermaid) for the repo-level dependency graph built by repo_graph.py."
    },
    {
      "file": "dt/site_cache.py",
      "description": "DVC core.site_cache_dir management. Resolves and applies a per-repo site_cache path (defaults to {site_cache.root}/{project_name}) via dvc config --local. Used by dt init, dt clone, and dt index set/migrate."
    },
    {
      "file": "dt/summary.py",
      "description": "Project summary generation. generate_dag() runs 'dvc dag --md' \u2192 docs/dag.md. generate_tree() runs 'dvc list --tree' \u2192 docs/tree.txt."
    },
    {
      "file": "dt/utils.py",
      "description": "Shared helpers: get_project_name(), check_dvc(), DependencyError."
    },
    {
      "file": "dt/archive/__init__.py",
      "description": "Remote archival package. Re-exports the operations/registry/manifest API."
    },
    {
      "file": "dt/archive/backends.py",
      "description": "Archive storage backends \u2014 where deposited archives physically land."
    },
    {
      "file": "dt/archive/manifest.py",
      "description": "Archive manifest: schema, load/dump, and discovery."
    },
    {
      "file": "dt/archive/signpost.py",
      "description": "Archive signposts \u2014 the breadcrumb left in the repo pointing at a deposited archive."
    },
    {
      "file": "dt/auth/__init__.py",
      "description": "Re-exports all public auth names. Backward-compat patch target."
    },
    {
      "file": "dt/auth/_helpers.py",
      "description": "Shared low-level helpers used across auth submodules."
    },
    {
      "file": "dt/auth/checks.py",
      "description": "Per-protocol connectivity checks (S3, GS, SSH, HTTP, GDrive). Used by dt auth check."
    },
